# Supabase
# 1. Create a free project at https://supabase.com
# 2. Project -> Settings -> API: copy "Project URL" and "service_role" key
# 3. Project -> SQL Editor: paste and run the contents of supabase/schema.sql
# 4. Paste the values below (and in Vercel for production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used in metadata, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://chabvekalaw.co.zw

# Display contact details. Replace with real values.
NEXT_PUBLIC_FIRM_PHONE=+263776519940
NEXT_PUBLIC_FIRM_EMAIL=info@chabvekalaw.co.zw
NEXT_PUBLIC_FIRM_ADDRESS=123 Samora Machel Avenue, Harare, Zimbabwe

# Display name shown across the site.
NEXT_PUBLIC_FIRM_NAME=Chabveka Law Firm
