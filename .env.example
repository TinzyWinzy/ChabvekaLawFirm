# Database (libSQL / SQLite / Turso)
# Local development: leave unset to use a local file at ./local.db
# Local with custom path: DATABASE_URL=file:./data/chabveka.db
# Production on Turso: DATABASE_URL=libsql://your-db.turso.io
#                      DATABASE_AUTH_TOKEN=your-turso-auth-token
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

